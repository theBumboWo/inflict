{
    "name": "key-wallet",
    "version": "0.1.0",
    "description": "Vendor-neutral, hardware-security-key-derived Solana wallet for desktop (devnet only)",
    "main": "dist/main/main/index.js",
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.main.json && npx vite build",
        "build:main": "tsc -p tsconfig.main.json",
        "build:renderer": "npx vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" --ext .ts,.tsx",
        "start": "npm run build && electron .",
        "dev": "electron .",
        "dist": "electron-builder",
        "postinstall": "electron-rebuild",
        "hardware:diagnose": "tsx scripts/hardware-diagnose.ts",
        "hardware:test": "tsx scripts/hardware-test.ts",
        "diagnostics": "tsx scripts/diagnostics.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.32.0",
        "@solana/web3.js": "1.99.0",
        "@vaultys/webauthn-node": "^0.1.1",
        "bs58": "6.0.0",
        "node-hid": "3.1.1",
        "qrcode.react": "4.2.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "uuid": "14.0.2",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@electron/rebuild": "4.2.0",
        "@types/node": "26.6.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/uuid": "11.0.0",
        "@typescript-eslint/eslint-plugin": "8.71.0",
        "@typescript-eslint/parser": "8.71.0",
        "@vitejs/plugin-react": "^4.7.0",
        "electron": "44.5.1",
        "electron-builder": "26.15.3",
        "eslint": "10.12.0",
        "fast-check": "4.10.2",
        "tsx": "^4.23.15",
        "typescript": "5.9.3",
        "vite": "8.3.2",
        "vitest": "5.0.3"
    },
    "build": {
        "appId": "com.keywallet.app",
        "productName": "KeyWallet",
        "icon": "assets/icon",
        "afterSign": "scripts/notarize.js",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "node_modules/**/*",
            "package.json",
            "libfido2-win/**/*"
        ],
        "asarUnpack": [
            "**/node_modules/node-hid/**",
            "**/node_modules/@vaultys/webauthn-node/**"
        ],
        "win": {
            "icon": "assets/icon.ico",
            "target": "nsis"
        },
        "mac": {
            "icon": "assets/icon.png",
            "target": "dmg"
        },
        "linux": {
            "icon": "assets/icon.png",
            "target": "AppImage"
        }
    }
}
