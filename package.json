{
    "name":  "key-wallet",
    "version":  "0.1.0",
    "description":  "Vendor-neutral, hardware-security-key-derived Solana wallet for desktop (devnet only)",
    "main":  "dist/main/main/index.js",
    "private":  true,
    "scripts":  {
                    "build":  "tsc -p tsconfig.main.json \u0026\u0026 npx vite build",
                    "build:main":  "tsc -p tsconfig.main.json",
                    "build:renderer":  "npx vite build",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "lint":  "eslint \"src/**/*.ts\" \"src/**/*.tsx\" --ext .ts,.tsx",
                    "start":  "npm run build \u0026\u0026 electron .",
                    "dev":  "electron .",
                    "dist":  "electron-builder"
                },
    "dependencies":  {
                         "@modelcontextprotocol/sdk":  "1.32.0",
                         "@solana/web3.js":  "1.99.0",
                         "bs58":  "6.0.0",
                         "qrcode.react":  "4.2.0",
                         "react":  "19.3.0",
                         "react-dom":  "19.3.0",
                         "uuid":  "14.0.2",
                         "zod":  "4.6.5"
                     },
    "devDependencies":  {
                            "@types/node":  "26.6.4",
                            "@types/react":  "19.3.0",
                            "@types/react-dom":  "19.3.0",
                            "@types/uuid":  "11.0.0",
                            "@typescript-eslint/eslint-plugin":  "8.71.0",
                            "@typescript-eslint/parser":  "8.71.0",
                            "@vitejs/plugin-react":  "^4.7.0",
                            "electron":  "44.5.1",
                            "electron-builder":  "26.15.3",
                            "eslint":  "10.12.0",
                            "fast-check":  "4.10.2",
                            "typescript":  "5.9.3",
                            "vite":  "8.3.2",
                            "vitest":  "5.0.3"
                        },
    "build":  {
                  "appId":  "com.keywallet.app",
                  "productName":  "KeyWallet",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "dist/**/*",
                                "node_modules/**/*",
                                "package.json"
                            ],
                  "win":  {
                              "target":  "nsis"
                          },
                  "mac":  {
                              "target":  "dmg"
                          },
                  "linux":  {
                                "target":  "AppImage"
                            }
              }
}
